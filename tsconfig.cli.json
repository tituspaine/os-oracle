{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src/cli",
    "outDir": "dist/cli",
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["src/cli/**/*.ts", "src/cli/**/*.d.ts"]
}
