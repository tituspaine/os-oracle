{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert",
        "content"
      ]
    ],
    "scope-enum": [
      1,
      "always",
      [
        "cli",
        "data",
        "routes",
        "components",
        "docs",
        "ci",
        "deps",
        "config",
        "kali",
        "playbooks",
        "distros",
        "walkthroughs",
        "errors",
        "search"
      ]
    ],
    "subject-case": [2, "never", ["start-case", "pascal-case", "upper-case"]],
    "header-max-length": [2, "always", 100]
  }
}
